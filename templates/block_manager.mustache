{{!
    @template block_download_certificates/block_manager

    The manager's section of the block: the numbers of the page's scope (the site, or the course
    the block stands on), the link to the manager page and "download all", which on a course page
    asks for that course's ZIP.

    Context variables required for this template:
    * heading - The section heading.
    * stats - The numbers: value, label.
    * manageurl - The manager page.
    * zip - A block_download_certificates/zip_form context, or false.

    Example context (json):
    {
        "heading": "Certificates of this course",
        "stats": [
            {"value": 12, "label": "Total"},
            {"value": 2, "label": "Last 7 days"}
        ],
        "manageurl": "https://example.com/blocks/download_certificates/index.php",
        "zip": {
            "url": "https://example.com/blocks/download_certificates/download_course.php",
            "type": "course",
            "count": 12,
            "threshold": 30,
            "sesskey": "abc123",
            "fields": [
                {"name": "action", "value": "download_course"},
                {"name": "courseid", "value": "7"}
            ],
            "label": "Download Course Certificates",
            "buttonclass": "btn-success btn-sm w-100",
            "confirm": false
        }
    }
}}
<h6 class="mb-2">{{heading}}</h6>
<dl class="row text-center mb-3 block-download-certificates-stats">
    {{#stats}}
    <div class="col d-flex flex-column-reverse">
        <dt class="small text-muted">{{label}}</dt>
        <dd class="h5 mb-0 block-download-certificates-number">{{value}}</dd>
    </div>
    {{/stats}}
</dl>
<a href="{{manageurl}}" class="btn btn-primary btn-sm w-100 mb-2">{{#str}}manage_certificates, block_download_certificates{{/str}}</a>
{{#zip}}
{{> block_download_certificates/zip_form}}
{{/zip}}
