{{!
    @template block_download_certificates/certificate_rows

    One page of the certificates table: sortable headers, rows and pager, rendered by
    certificate_table.js from the search web service's result. Names arrive unescaped and are
    escaped here, once.

    Data attributes required for JS:
    * data-sort - The sort key a header button sets.
    * data-page - The page, from 0, a pager button opens.

    Context variables required for this template:
    * hasrows - Whether the page holds rows.
    * emptymessage - The text shown when it holds none.
    * columns - For each sortable column (firstname, email, coursename, templatename, type,
      timecreated): ariasort (ascending, descending or none) and icon (a Font Awesome class).
    * rows - The rows: fullname, email, coursename, templatename, typename, datecreated, downloadurl.
    * pagination - haspages; previous and next, each with page and disabled; pages, each with page,
      label, active and ellipsis.

    Example context (json):
    {
        "hasrows": true,
        "emptymessage": "No certificates found",
        "columns": {
            "firstname": {"ariasort": "none", "icon": "fa-sort"},
            "email": {"ariasort": "none", "icon": "fa-sort"},
            "coursename": {"ariasort": "none", "icon": "fa-sort"},
            "templatename": {"ariasort": "none", "icon": "fa-sort"},
            "type": {"ariasort": "none", "icon": "fa-sort"},
            "timecreated": {"ariasort": "descending", "icon": "fa-sort-down"}
        },
        "rows": [
            {
                "fullname": "Ada Lovelace",
                "email": "ada@example.com",
                "coursename": "Analytical engines",
                "templatename": "Certificate of completion",
                "typename": "Course certificate",
                "datecreated": "Tuesday, 20 October 2026, 10:00 AM",
                "downloadurl": "https://example.com/blocks/download_certificates/download_precise.php?type=customcert&issueid=1"
            }
        ],
        "pagination": {
            "haspages": true,
            "previous": {"page": 0, "disabled": true},
            "next": {"page": 1, "disabled": false},
            "pages": [
                {"page": 0, "label": 1, "active": true, "ellipsis": false},
                {"page": 1, "label": 2, "active": false, "ellipsis": false}
            ]
        }
    }
}}
{{#hasrows}}
<div class="table-responsive">
    <table class="table table-striped table-hover cert-table mb-0">
        <thead>
            <tr>
                <th scope="col" aria-sort="{{columns.firstname.ariasort}}">
                    <button type="button" class="btn btn-link p-0 text-reset cert-sort" data-sort="firstname">
                        {{#str}}user, core{{/str}} <i class="fa {{columns.firstname.icon}}" aria-hidden="true"></i>
                    </button>
                </th>
                <th scope="col" aria-sort="{{columns.email.ariasort}}">
                    <button type="button" class="btn btn-link p-0 text-reset cert-sort" data-sort="email">
                        {{#str}}email, core{{/str}} <i class="fa {{columns.email.icon}}" aria-hidden="true"></i>
                    </button>
                </th>
                <th scope="col" aria-sort="{{columns.coursename.ariasort}}">
                    <button type="button" class="btn btn-link p-0 text-reset cert-sort" data-sort="coursename">
                        {{#str}}course, core{{/str}} <i class="fa {{columns.coursename.icon}}" aria-hidden="true"></i>
                    </button>
                </th>
                <th scope="col" aria-sort="{{columns.templatename.ariasort}}">
                    <button type="button" class="btn btn-link p-0 text-reset cert-sort" data-sort="templatename">
                        {{#str}}template, block_download_certificates{{/str}}
                        <i class="fa {{columns.templatename.icon}}" aria-hidden="true"></i>
                    </button>
                </th>
                <th scope="col" aria-sort="{{columns.type.ariasort}}">
                    <button type="button" class="btn btn-link p-0 text-reset cert-sort" data-sort="type">
                        {{#str}}type, block_download_certificates{{/str}} <i class="fa {{columns.type.icon}}" aria-hidden="true"></i>
                    </button>
                </th>
                <th scope="col" aria-sort="{{columns.timecreated.ariasort}}">
                    <button type="button" class="btn btn-link p-0 text-reset cert-sort" data-sort="timecreated">
                        {{#str}}date_created, block_download_certificates{{/str}}
                        <i class="fa {{columns.timecreated.icon}}" aria-hidden="true"></i>
                    </button>
                </th>
                <th scope="col" class="text-center">{{#str}}actions, core{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr class="cert-row">
                <td><strong>{{fullname}}</strong></td>
                <td><small class="text-muted">{{email}}</small></td>
                <td>{{coursename}}</td>
                <td>{{templatename}}</td>
                <td><span class="badge bg-secondary text-dark">{{typename}}</span></td>
                <td><small>{{datecreated}}</small></td>
                <td class="text-center">
                    <a href="{{downloadurl}}" class="btn btn-sm btn-outline-primary"
                       aria-label="{{#str}}download_certificate, block_download_certificates{{/str}}"
                       title="{{#str}}download_certificate, block_download_certificates{{/str}}">
                        <i class="fa fa-download" aria-hidden="true"></i>
                    </a>
                </td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
</div>
{{/hasrows}}
{{^hasrows}}
<div class="alert alert-info text-center m-3">
    <i class="fa fa-info-circle fa-2x mb-2" aria-hidden="true"></i>
    <p class="mb-0">{{emptymessage}}</p>
</div>
{{/hasrows}}
{{#pagination.haspages}}
<nav aria-label="{{#str}}page, core{{/str}}">
    <ul class="pagination pagination-sm justify-content-center my-3">
        {{#pagination.previous}}
        <li class="page-item{{#disabled}} disabled{{/disabled}}">
            <button type="button" class="page-link" data-page="{{page}}" aria-label="{{#str}}previous, core{{/str}}"
                {{#disabled}}disabled{{/disabled}}>
                <i class="fa fa-chevron-left" aria-hidden="true"></i>
            </button>
        </li>
        {{/pagination.previous}}
        {{#pagination.pages}}
        {{#ellipsis}}
        <li class="page-item disabled"><span class="page-link" aria-hidden="true">&hellip;</span></li>
        {{/ellipsis}}
        {{^ellipsis}}
        <li class="page-item{{#active}} active{{/active}}">
            <button type="button" class="page-link" data-page="{{page}}" {{#active}}aria-current="page"{{/active}}>{{label}}</button>
        </li>
        {{/ellipsis}}
        {{/pagination.pages}}
        {{#pagination.next}}
        <li class="page-item{{#disabled}} disabled{{/disabled}}">
            <button type="button" class="page-link" data-page="{{page}}" aria-label="{{#str}}next, core{{/str}}"
                {{#disabled}}disabled{{/disabled}}>
                <i class="fa fa-chevron-right" aria-hidden="true"></i>
            </button>
        </li>
        {{/pagination.next}}
    </ul>
</nav>
{{/pagination.haspages}}
