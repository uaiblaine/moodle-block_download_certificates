{{!
    @template block_download_certificates/main_page

    The manager page (index.php): the header with "download all", the download tabs (date range,
    course, cohort, user) and the certificates table. The context comes from
    \block_download_certificates\output\panel_page::manager().

    Context variables required for this template:
    * heading, total, totallabel, downloadall - As block_download_certificates/page_header.
    * hastabs, tabs - As block_download_certificates/filter_bar; hastabs is false without certificates.
    * hascertificates, emptymessage, emptydescription, perpage - As block_download_certificates/table_card.

    Example context (json):
    {
        "heading": "Certificate Management",
        "total": 42,
        "totallabel": "Total certificates",
        "downloadall": {
            "url": "https://example.com/blocks/download_certificates/download.php",
            "type": "all",
            "count": 42,
            "threshold": 30,
            "sesskey": "abc123",
            "fields": [{"name": "action", "value": "download_all"}],
            "label": "Download All Certificates",
            "buttonclass": "btn-primary",
            "confirm": "Are you sure you want to download all certificates?"
        },
        "hascertificates": true,
        "hastabs": true,
        "tabs": [
            {
                "id": "daterange",
                "icon": "fa-calendar",
                "label": "By date range",
                "help": "Select a date range to download all certificates issued within that period.",
                "active": true,
                "range": {
                    "url": "https://example.com/blocks/download_certificates/download_range.php",
                    "sesskey": "abc123",
                    "count": 42,
                    "threshold": 30,
                    "buttonlabel": "Download Range"
                },
                "menu": false
            },
            {
                "id": "cohort",
                "icon": "fa-users",
                "label": "By cohort",
                "help": "Select a cohort to download all certificates for its members.",
                "active": false,
                "range": false,
                "menu": {
                    "url": "https://example.com/blocks/download_certificates/download_cohort.php",
                    "sesskey": "abc123",
                    "threshold": 30,
                    "type": "cohort",
                    "action": "download_cohort",
                    "selectid": "cohort_select",
                    "name": "cohortid",
                    "selectlabel": "Cohort",
                    "placeholder": "Choose a cohort...",
                    "options": [
                        {"value": 3, "text": "Class of 2026", "count": 9}
                    ],
                    "groups": false,
                    "buttonlabel": "Download Cohort Certificates"
                }
            }
        ],
        "emptymessage": "No certificates found",
        "emptydescription": "There are no certificates available for download at this time.",
        "perpage": [
            {"value": 25, "selected": false},
            {"value": 50, "selected": true}
        ]
    }
}}
<div class="block-download-certificates-page">
    {{> block_download_certificates/page_header}}
    {{#hastabs}}
    {{> block_download_certificates/filter_bar}}
    {{/hastabs}}
    {{> block_download_certificates/table_card}}
</div>
