{{!
    @template block_download_certificates/table_card

    The certificates table of the manager and teacher pages. certificate_table.js fills the
    container through the search web service and keeps the count in step; both announce their
    changes.

    Context variables required for this template:
    * total - The certificates in scope.
    * hascertificates - Whether the scope holds any.
    * emptymessage - The text when it holds none.
    * emptydescription - A second line under it, or empty.
    * perpage - As block_download_certificates/search_bar.

    Example context (json):
    {
        "total": 42,
        "hascertificates": true,
        "emptymessage": "No certificates found",
        "emptydescription": "There are no certificates available for download at this time.",
        "perpage": [
            {"value": 25, "selected": false},
            {"value": 50, "selected": true}
        ]
    }
}}
<div class="card block-download-certificates-table-card">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h3 class="h5 mb-0">
                <i class="fa fa-list me-1" aria-hidden="true"></i>{{#str}}certificate_list, block_download_certificates{{/str}}
            </h3>
            <span id="cert-result-count" class="badge bg-secondary text-dark" aria-live="polite">{{total}} {{#str}}certificates, block_download_certificates{{/str}}</span>
        </div>
        {{> block_download_certificates/search_bar}}
    </div>
    <div class="card-body p-0">
        <div id="cert-table-container" aria-live="polite">
            {{#hascertificates}}
            <div class="text-center py-4">
                <i class="fa fa-spinner fa-spin fa-2x text-primary" aria-hidden="true"></i>
                <p class="mt-2 mb-0 text-muted">{{#str}}loading, core{{/str}}</p>
            </div>
            {{/hascertificates}}
            {{^hascertificates}}
            <div class="alert alert-info text-center m-3">
                <p class="mb-0">{{emptymessage}}</p>
                {{#emptydescription}}
                <p class="small mb-0">{{emptydescription}}</p>
                {{/emptydescription}}
            </div>
            {{/hascertificates}}
        </div>
    </div>
</div>
