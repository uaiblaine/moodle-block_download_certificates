{{!
    @template block_download_certificates/block_teacher

    The section of the block for a user with courses of their own: the certificates their scope
    reaches and the link to the teacher page.

    Context variables required for this template:
    * count - The certificates in the viewer's scope, narrowed to the page.
    * panelurl - The teacher page.

    Example context (json):
    {
        "count": 18,
        "panelurl": "https://example.com/blocks/download_certificates/index_teacher.php"
    }
}}
<div class="d-flex flex-column-reverse text-center mb-3">
    <p class="small text-muted mb-0">{{#str}}teacher_certificates, block_download_certificates{{/str}}</p>
    <p class="h4 mb-0 block-download-certificates-number">{{count}}</p>
</div>
<a href="{{panelurl}}" class="btn btn-primary btn-sm w-100 mb-2">{{#str}}teacher_panel, block_download_certificates{{/str}}</a>
