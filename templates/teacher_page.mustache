{{!
    @template block_download_certificates/teacher_page

    The teacher page (index_teacher.php): the header, the course tab (with its group menu) and the
    user tab, and the certificates table, all within the teacher's scope. The context comes from
    \block_download_certificates\output\panel_page::teacher().

    Context variables required for this template:
    * heading, total, totallabel, downloadall - As block_download_certificates/page_header.
    * hastabs, tabs - As block_download_certificates/filter_bar; hastabs is false without certificates.
    * hascertificates, emptymessage, emptydescription, perpage - As block_download_certificates/table_card.

    Example context (json):
    {
        "heading": "Teacher Panel",
        "total": 42,
        "totallabel": "Certificates from your students",
        "downloadall": false,
        "hascertificates": true,
        "hastabs": true,
        "tabs": [
            {
                "id": "course",
                "icon": "fa-graduation-cap",
                "label": "By course",
                "help": "Select a course to download all certificates issued for that course.",
                "active": true,
                "range": false,
                "menu": {
                    "url": "https://example.com/blocks/download_certificates/download_course.php",
                    "sesskey": "abc123",
                    "threshold": 30,
                    "type": "course",
                    "action": "download_course",
                    "selectid": "course_select",
                    "name": "courseid",
                    "selectlabel": "Course",
                    "placeholder": "-- Choose a course --",
                    "options": [
                        {
                            "value": 7,
                            "text": "Analytical engines",
                            "count": 12
                        }
                    ],
                    "groups": true,
                    "buttonlabel": "Download Course Certificates"
                }
            }
        ],
        "emptymessage": "No certificates found within your scope.",
        "emptydescription": "",
        "perpage": [
            {
                "value": 25,
                "selected": false
            },
            {
                "value": 50,
                "selected": true
            }
        ]
    }
}}
<div class="block-download-certificates-page">
    {{> block_download_certificates/page_header}}
    {{#hastabs}}
    {{> block_download_certificates/filter_bar}}
    {{/hastabs}}
    {{> block_download_certificates/table_card}}
</div>
