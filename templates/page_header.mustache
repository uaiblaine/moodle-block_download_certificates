{{!
    @template block_download_certificates/page_header

    The header card of the manager and teacher pages: the page's own heading, the number of
    certificates in scope and, on the manager page, "download all".

    Context variables required for this template:
    * heading - The heading.
    * total - The certificates in scope.
    * totallabel - What the total counts.
    * downloadall - A block_download_certificates/zip_form context, or false.

    Example context (json):
    {
        "heading": "Certificate Management",
        "total": 42,
        "totallabel": "Total certificates",
        "downloadall": {
            "url": "https://example.com/blocks/download_certificates/download.php",
            "type": "all",
            "count": 42,
            "threshold": 30,
            "sesskey": "abc123",
            "fields": [{"name": "action", "value": "download_all"}],
            "label": "Download All Certificates",
            "buttonclass": "btn-primary",
            "confirm": "Are you sure you want to download all certificates?"
        }
    }
}}
<div class="card mb-4">
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center">
            <i class="fa fa-certificate fa-3x text-primary me-3" aria-hidden="true"></i>
            <div>
                <h2 class="mb-0">{{heading}}</h2>
                <p class="text-muted mb-0">
                    <strong class="block-download-certificates-number">{{total}}</strong> {{totallabel}}
                </p>
            </div>
        </div>
        {{#downloadall}}
        {{> block_download_certificates/zip_form}}
        {{/downloadall}}
    </div>
</div>
